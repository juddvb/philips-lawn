# Copy to .env and fill in from Supabase: Project Settings > API.
# Only the publishable (anon) key goes here; it is bundled into the app.
# Never put the secret / service_role key in an EXPO_PUBLIC_ variable.
# Leave these blank to run the app in demo mode.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
